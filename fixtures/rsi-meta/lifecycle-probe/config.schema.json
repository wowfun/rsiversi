{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-meta.invalid/fixtures/lifecycle-probe-config-v0.json",
  "title": "Lifecycle probe fixture configuration",
  "type": "object",
  "properties": {
    "fail_prepare": {
      "type": "boolean"
    },
    "retire_mode": {
      "enum": ["ack", "hold", "reject"]
    },
    "tag": {
      "type": "string"
    },
    "prepare_action": {
      "enum": [
        "state_get_then_ack",
        "state_write_then_ack",
        "malformed_state_then_fail",
        "normal_ack",
        "durable_then_ack",
        "outbound_open_then_ack"
      ],
      "default": "state_get_then_ack"
    },
    "stream_fault": {
      "enum": [
        "none",
        "wrong_service",
        "unknown_event",
        "non_byte_data",
        "malformed_json",
        "malformed_json_burst"
      ],
      "default": "none"
    }
  },
  "required": ["fail_prepare", "retire_mode", "tag"],
  "additionalProperties": false
}
