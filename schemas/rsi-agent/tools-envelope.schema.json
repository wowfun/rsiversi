{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-agent.invalid/schemas/tools-envelope-v1.json",
  "title": "rsi-agent tools envelope v1",
  "$comment": "This schema owns the closed JSON control plane. rsi-agent-protocol additionally enforces aggregate byte, recursive JSON, digest, media, and per-envelope semantic invariants. Cross-frame lifecycle validation belongs to a future owning runtime.",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "owner_id", "owner_epoch", "execution_cwd", "tool_policy_sha256"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "owner_open_request" },
        "owner_id": { "$ref": "#/$defs/identifier" },
        "owner_epoch": { "$ref": "#/$defs/identifier" },
        "execution_cwd": { "$ref": "#/$defs/path" },
        "tool_policy_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "owner_id", "owner_epoch", "terminal_types"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "owner_open_response" },
        "owner_id": { "$ref": "#/$defs/identifier" },
        "owner_epoch": { "$ref": "#/$defs/identifier" },
        "terminal_types": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolName" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "catalog_request" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "tools"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "catalog_response" },
        "tools": { "$ref": "#/$defs/catalog" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "call_id", "name", "arguments", "time_budget_ms"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "invoke_request" },
        "call_id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/toolName" },
        "arguments": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000\\u007F]*$" },
        "time_budget_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "call_id", "result"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "invoke_response" },
        "call_id": { "$ref": "#/$defs/identifier" },
        "result": { "$ref": "#/$defs/toolResult" },
        "private_result": { "$ref": "#/$defs/privateResult" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "target_request_id", "reason"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "cancel_invoke" },
        "target_request_id": { "$ref": "#/$defs/identifier" },
        "reason": { "$ref": "#/$defs/message" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "notification_id", "delivery", "content"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "notification" },
        "notification_id": { "$ref": "#/$defs/identifier" },
        "delivery": { "enum": ["quiet", "wakeup"] },
        "content": { "$ref": "#/$defs/toolContentList" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "call_id"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "commit_result" },
        "call_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "blob"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "blob_start" },
        "blob": { "$ref": "#/$defs/image" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "blob_id"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "blob_end" },
        "blob_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "version", "request_id", "kind", "error"],
      "properties": {
        "protocol": { "const": "rsi.agent.tools" },
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "error" },
        "error": { "$ref": "#/$defs/error" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$" },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000\\u007F]+$" },
    "errorCode": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\u007F]*$" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["blob_id", "mime_type", "byte_len", "sha256"],
      "properties": {
        "blob_id": { "$ref": "#/$defs/identifier" },
        "mime_type": { "type": "string", "pattern": "^image/[A-Za-z0-9.+-]+$", "maxLength": 127 },
        "byte_len": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "dependentRequired": { "width": ["height"], "height": ["width"] },
      "additionalProperties": false
    },
    "toolContent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "maxLength": 524288, "pattern": "^[^\\u0000\\u007F]*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "image"],
          "properties": { "type": { "const": "image" }, "image": { "$ref": "#/$defs/image" } },
          "additionalProperties": false
        }
      ]
    },
    "toolContentList": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/toolContent" } },
    "toolResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "content"],
          "properties": { "status": { "const": "ok" }, "content": { "$ref": "#/$defs/toolContentList" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "code", "message"],
          "properties": {
            "status": { "const": "error" },
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\u007F]*$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "appliedPatchChange": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path", "new_sha256"],
          "properties": {
            "kind": { "const": "add" },
            "path": { "$ref": "#/$defs/path" },
            "new_sha256": { "$ref": "#/$defs/sha256" },
            "overwritten_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path", "old_sha256", "new_sha256"],
          "properties": {
            "kind": { "const": "update" },
            "path": { "$ref": "#/$defs/path" },
            "old_sha256": { "$ref": "#/$defs/sha256" },
            "new_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path", "old_sha256"],
          "properties": {
            "kind": { "const": "delete" },
            "path": { "$ref": "#/$defs/path" },
            "old_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path", "move_to", "old_sha256", "new_sha256"],
          "properties": {
            "kind": { "const": "move" },
            "path": { "$ref": "#/$defs/path" },
            "move_to": { "$ref": "#/$defs/path" },
            "old_sha256": { "$ref": "#/$defs/sha256" },
            "new_sha256": { "$ref": "#/$defs/sha256" },
            "overwritten_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      ]
    },
    "privateResult": {
      "type": "object",
      "required": ["type", "delta"],
      "properties": {
        "type": { "const": "applied_patch_delta" },
        "delta": {
          "type": "object",
          "required": ["exact", "changes"],
          "properties": {
            "exact": { "type": "boolean" },
            "changes": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/appliedPatchChange" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "freeform": {
      "type": "object",
      "required": ["format", "grammar"],
      "properties": {
        "format": { "const": "lark" },
        "grammar": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000\\u007F]+$" }
      },
      "additionalProperties": false
    },
    "toolDefinition": {
      "type": "object",
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": { "$ref": "#/$defs/toolName" },
        "description": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\u007F]*$" },
        "input_schema": { "type": ["object", "boolean"] },
        "freeform": { "$ref": "#/$defs/freeform" }
      },
      "additionalProperties": false
    },
    "catalog": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/toolDefinition" } }
  }
}
