{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-ai.invalid/v0/transcription-request.schema.json",
  "title": "rsi-ai transcription request v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["audio", "language", "prompt", "timestamps"],
  "properties": {
    "audio": {"$ref": "#/$defs/audio"},
    "language": {"type": ["string", "null"], "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
    "prompt": {"type": ["string", "null"], "minLength": 1, "maxLength": 16777216},
    "timestamps": {"type": "boolean"}
  },
  "$defs": {
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "mime_type", "byte_len", "sha256", "width", "height", "duration_ms"],
      "properties": {
        "kind": {"const": "audio"},
        "mime_type": {"type": "string", "pattern": "^audio/[A-Za-z0-9.+-]+$", "maxLength": 127},
        "byte_len": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "null"},
        "height": {"type": "null"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
