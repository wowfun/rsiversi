{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-ai.invalid/v0/speech-request.schema.json",
  "title": "rsi-ai speech request v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "voice", "format", "speed"],
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 16777216},
    "voice": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
    "format": {"enum": ["pcm16", "wav", "mp3"]},
    "speed": {"type": ["number", "null"], "minimum": 0.25, "maximum": 4.0}
  }
}
