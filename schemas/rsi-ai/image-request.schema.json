{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-ai.invalid/v0/image-request.schema.json",
  "title": "rsi-ai image request v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "count", "inputs", "mask"],
  "properties": {
    "prompt": {"type": "string", "minLength": 1, "maxLength": 16777216},
    "count": {"type": "integer", "minimum": 1, "maximum": 10},
    "inputs": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/image"}},
    "mask": {"anyOf": [{"$ref": "#/$defs/image"}, {"type": "null"}]}
  },
  "$defs": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "mime_type", "byte_len", "sha256", "width", "height", "duration_ms"],
      "properties": {
        "kind": {"const": "image"},
        "mime_type": {"type": "string", "pattern": "^image/[A-Za-z0-9.+-]+$", "maxLength": 127},
        "byte_len": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "height": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "duration_ms": {"type": "null"}
      }
    }
  }
}
