{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-meta.invalid/schemas/plugin-v0.json",
  "title": "rsi-meta plugin package manifest v0",
  "type": "object",
  "$defs": {
    "service": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
    }
  },
  "required": ["format_version", "package", "host_api", "artifacts"],
  "properties": {
    "format_version": { "const": 0 },
    "package": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": { "type": "string", "minLength": 1 },
        "process_fixed": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "host_api": {
      "type": "object",
      "required": ["major", "minimum_minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "minimum_minor": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "path"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/service" }
    },
    "injects": {
      "type": "array",
      "uniqueItems": true,
      "description": "Exact duplicate entries are invalid. The loader additionally rejects any repeated contract even when required differs; draft 2020-12 cannot express uniqueness by one object property.",
      "items": {
        "type": "object",
        "required": ["contract"],
        "properties": {
          "contract": { "$ref": "#/$defs/service" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "config_schema": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
