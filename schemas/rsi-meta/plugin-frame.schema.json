{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-meta.invalid/schemas/plugin-frame-v0.json",
  "title": "rsi-meta native plugin frame v0",
  "type": "object",
  "required": ["protocol", "version", "kind"],
  "properties": {
    "protocol": { "const": "rsi-meta.plugin" },
    "version": { "const": 0 },
    "kind": {
      "enum": ["lifecycle", "service_request", "service_event", "durable_command"]
    },
    "phase": {
      "enum": [
        "prepare",
        "prepared",
        "prepare_failed",
        "abort",
        "committed",
        "retire",
        "retired"
      ]
    },
    "generation": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "config": {},
    "request_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "service": { "type": "string", "minLength": 1, "maxLength": 255 },
    "operation": { "type": "string", "minLength": 1, "maxLength": 255 },
    "event": { "type": "string", "minLength": 1, "maxLength": 255 },
    "payload": {},
    "command_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "command": {
      "type": "object",
      "required": ["type", "manifest_path", "lock_path"],
      "properties": {
        "type": { "const": "apply_manifest_path" },
        "manifest_path": { "type": "string" },
        "lock_path": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "lifecycle" } } },
      "then": {
        "required": ["phase", "generation"],
        "not": {
          "anyOf": [
            { "required": ["request_id"] },
            { "required": ["service"] },
            { "required": ["operation"] },
            { "required": ["event"] },
            { "required": ["payload"] },
            { "required": ["command_id"] },
            { "required": ["command"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "lifecycle" },
          "phase": { "const": "prepare_failed" }
        },
        "required": ["kind", "phase"]
      },
      "then": {
        "required": ["config"],
        "properties": {
          "config": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "message": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "lifecycle" },
          "phase": {
            "enum": ["prepared", "abort", "committed", "retire", "retired"]
          }
        },
        "required": ["kind", "phase"]
      },
      "then": { "not": { "required": ["config"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "service_request" } } },
      "then": {
        "required": ["request_id", "service", "operation", "payload"],
        "not": {
          "anyOf": [
            { "required": ["phase"] },
            { "required": ["generation"] },
            { "required": ["config"] },
            { "required": ["event"] },
            { "required": ["command_id"] },
            { "required": ["command"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "service_request" },
          "operation": { "const": "data" }
        },
        "required": ["kind", "operation"]
      },
      "then": false
    },
    {
      "if": { "properties": { "kind": { "const": "service_event" } } },
      "then": {
        "required": ["service", "event", "payload"],
        "not": {
          "anyOf": [
            { "required": ["phase"] },
            { "required": ["generation"] },
            { "required": ["config"] },
            { "required": ["operation"] },
            { "required": ["command_id"] },
            { "required": ["command"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "service_event" },
          "event": { "const": "data" }
        },
        "required": ["kind", "event"]
      },
      "then": false
    },
    {
      "if": { "properties": { "kind": { "const": "durable_command" } } },
      "then": {
        "required": ["command_id", "command"],
        "not": {
          "anyOf": [
            { "required": ["phase"] },
            { "required": ["generation"] },
            { "required": ["config"] },
            { "required": ["request_id"] },
            { "required": ["service"] },
            { "required": ["operation"] },
            { "required": ["event"] },
            { "required": ["payload"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
