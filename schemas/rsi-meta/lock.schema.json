{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-meta.invalid/schemas/lock-v0.json",
  "title": "rsi-meta lock file v0",
  "type": "object",
  "required": ["format_version", "target", "manifest_sha256"],
  "properties": {
    "format_version": { "const": 0 },
    "target": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packages": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "version", "path", "manifest_sha256", "artifact_sha256"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "version": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical absolute local path to plugin.toml; package identity is separate from mounted instance identity."
          },
          "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "config_schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Present when plugin.toml declares config_schema; pins the exact local schema bytes."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
