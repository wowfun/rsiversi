{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "/mounts.js": ["mounts.js"],
      "@rsi/dsh-slots": [
        "vendor/dsh/slots/index.ts"
      ],
      "@rsi/dsh-store-contract": [
        "vendor/dsh/store-contract.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "src",
    "vendor/dsh",
    "tests/*.types.ts",
    "vite.config.mjs"
  ]
}
