{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi-ai.invalid/plugins/openai-config-v0.json",
  "type": "object",
  "properties": {
    "deployment_id": { "type": "string", "default": "openai", "minLength": 1, "maxLength": 255 },
    "endpoint": { "type": "string", "default": "https://api.openai.com", "format": "uri" },
    "api_key": { "type": "string", "minLength": 1, "maxLength": 65536, "x-rsi-meta-secret": true }
  },
  "required": ["api_key"],
  "additionalProperties": false
}

